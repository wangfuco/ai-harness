{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/ai-harness/stage.schema.json",
  "title": "AI Harness Stage Manifest",
  "description": "Local in-progress schema for AI Harness runner manifests. This is not a universal workflow or runner schema.",
  "type": "object",
  "required": [
    "id",
    "name",
    "order",
    "prompt",
    "role",
    "kind",
    "inputs",
    "outputs",
    "permissions",
    "approval",
    "entry_conditions",
    "exit_conditions"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "order": {
      "type": "integer",
      "minimum": 1
    },
    "prompt": {
      "type": "string"
    },
    "global_contract": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "planning",
        "contract",
        "acceptance",
        "work_package",
        "execution",
        "review"
      ]
    },
    "interaction_mode": {
      "type": "string"
    },
    "inputs": {
      "type": "object",
      "required": [
        "required",
        "optional"
      ],
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "optional": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "conditional": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "outputs": {
      "type": "object",
      "required": [
        "primary_artifact",
        "allowed_artifacts"
      ],
      "properties": {
        "primary_artifact": {
          "type": "string"
        },
        "allowed_artifacts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "decision_values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "permissions": {
      "type": "object",
      "required": [
        "may_read_source",
        "may_write_source",
        "may_run_commands",
        "allowed_write_paths",
        "forbidden_write_paths"
      ],
      "properties": {
        "may_read_source": {
          "type": "boolean"
        },
        "may_write_source": {
          "type": "boolean"
        },
        "may_run_commands": {
          "type": "boolean"
        },
        "allowed_write_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "forbidden_write_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "approval": {
      "type": "object",
      "required": [
        "required_before_next_stage",
        "approved_by"
      ],
      "properties": {
        "required_before_next_stage": {
          "type": "boolean"
        },
        "approved_by": {
          "type": "string"
        }
      }
    },
    "entry_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "exit_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "hard_red_lines": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "handoff_summary_required": {
      "type": "boolean"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
